# Application
APP_NAME=NEXUS
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
PORT=8000

# PostgreSQL (host-accessible development port)
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://nexus:nexus@localhost:5433/nexus

# Redis (host-accessible development port)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0
REDIS_URL=redis://localhost:6380/0

# Frontend browser requests use the backend's published host port.
NEXT_PUBLIC_API_URL=http://localhost:8001

# Authentication (use a long random secret and change the migration admin password)
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=60
ADMIN_EMAIL=admin@nexus.local
ADMIN_PASSWORD=change-me-immediately
FRONTEND_ORIGIN=http://localhost:3001
